# ============================================================
# Cấu hình môi trường — Copy file này thành .env và sửa giá trị
# ============================================================

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=replace_with_a_strong_secret_key

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=face_attendance_db
DB_USER=root
DB_PASSWORD=

# AI Engine: 'insightface', 'yolo_resnet', hoặc 'deepface'
AI_ENGINE=insightface

# ─── DeepFace Config (chỉ khi AI_ENGINE=deepface) ───
# Model nhận diện: VGG-Face, Facenet, Facenet512, ArcFace, SFace, GhostFaceNet, Dlib, DeepID, OpenFace, Buffalo_L
DEEPFACE_MODEL=ArcFace
# Detector: opencv, retinaface, mtcnn, ssd, dlib, mediapipe, yolov8n, yolov11n, centerface, yunet
DEEPFACE_DETECTOR=retinaface
# Anti-spoofing (chống giả mạo): true/false
DEEPFACE_ANTI_SPOOFING=false
# Phân tích thuộc tính: age,gender,emotion,race (để trống = tắt)
DEEPFACE_ANALYSIS_ACTIONS=

# Ngưỡng nhận diện
SIMILARITY_THRESHOLD=0.45
MOTION_THRESHOLD=3000
ALERT_COOLDOWN=20
DB_LOG_COOLDOWN=28800

# Telegram Canh Bao (tuy chon)
# Neu token bi lo, phai rotate ngay tren BotFather
TELEGRAM_BOT_TOKEN=8762386247:AAEBvm2-qGIXf2T8gsiK5n8hXxlqqwak39c
TELEGRAM_CHAT_ID=7724279500

# === Docker Compose ===
# Khi chạy Docker, DB_HOST sẽ được override thành 'db'
# DB_PASSWORD nên đặt khác rỗng, ví dụ:
# DB_PASSWORD=root123
