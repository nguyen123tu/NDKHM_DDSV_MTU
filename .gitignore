# ============================================================
# .gitignore: MTUFace (Security & Hygiene)
# ============================================================

# Environment Variables & Sensitive Secrets
.env
.env.*
!.env.example
serviceAccountKey*.json
*.pem
*.key

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/
env/
.env_venv/

# Large AI Model Binaries & Serialized Embeddings
*.pkl
*.npz
*.onnx
*.pt
*.pth
*.weights
*.h5
models/*.pkl
models/*.onnx
models/*.npz
insightface/

# Runtime Database, Media Uploads & Evidence
database/
dataset/
evidence/
exports/
uploads/
models/chroma_db/
mssql_data/
*.log
tmp/
temp/

# Flutter Mobile App Build Artifacts & Large Binaries
mobile_flutter/build/
mobile_flutter/.dart_tool/
mobile_flutter/.flutter-plugins
mobile_flutter/.flutter-plugins-dependencies
*.apk
*.aab

# IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store
_backup/

# Legacy scripts & temporary files
SO TAY SV 2020v4.pdf
_fix_db.py
migrate_old_database.py

# Archived scripts
scripts/archive/
